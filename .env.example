# 複製為 .env 後只在本機使用。不要提交 .env，也不要填入正式密碼。

NODE_ENV=development
APP_ENV=local
PORT=4000
DATABASE_URL=postgresql://mf:mf_dev_password@127.0.0.1:54329/mf_dev?schema=public
SESSION_SECRET=local-dev-session-secret-change-me
APP_BASE_URL=http://127.0.0.1:4000
STORAGE_DRIVER=local
UPLOAD_ROOT=./uploads
MAIL_DRIVER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=noreply@example.test
# 僅 local / staging 可為 true。production 必須為 false。
DEMO_MODE=true
VITE_API_BASE_URL=/api/v1
# 本地展示用 mock；串接 API 時改為 api。正式 build 必須是 api。
VITE_DATA_MODE=mock
WEB_DEV_ORIGIN=http://127.0.0.1:5173
