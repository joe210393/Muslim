  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  payments PaymentRecord[]
  images   ServicePlanImage[]
  viewers  ServicePlanViewer[]

  @@map("service_plans")
}

/** 空名單＝全體業者可見；有名單＝僅指定使用者可見。 */
model ServicePlanViewer {
  id        String   @id @default(uuid()) @db.Uuid
  planId    String   @map("plan_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  plan ServicePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([planId, userId])
  @@index([userId])
  @@map("service_plan_viewers")
}

model ServicePlanImage {
