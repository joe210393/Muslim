  planId    String   @map("plan_id") @db.Uuid
  fileId    String   @unique @map("file_id") @db.Uuid
  caption   String   @default("") @db.VarChar(200)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  plan ServicePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  file FileObject  @relation("ServicePlanImage", fields: [fileId], references: [id], onDelete: Restrict)

  @@index([planId, sortOrder])
  @@map("service_plan_images")
}

model PaymentRecord {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  organizationName String   @map("organization_name") @db.VarChar(200)
  planId           String   @map("plan_id") @db.Uuid
  planName         String        @map("plan_name") @db.VarChar(80)
  amount           Int
  status           PaymentStatus @default(PENDING)
  merchantTradeNo  String?       @unique @map("merchant_trade_no") @db.VarChar(20)
  ecpayTradeNo     String?       @map("ecpay_trade_no") @db.VarChar(20)
  paymentMethod    String        @default("") @map("payment_method") @db.VarChar(20)
  paidAt           DateTime?     @map("paid_at") @db.Timestamptz(6)
  quoteConfirmedAt DateTime?     @map("quote_confirmed_at") @db.Timestamptz(6)
  accountingConfirmedAt DateTime? @map("accounting_confirmed_at") @db.Timestamptz(6)
  recordedById     String?       @map("recorded_by_id") @db.Uuid
  note             String        @default("") @db.VarChar(200)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  plan         ServicePlan  @relation(fields: [planId], references: [id], onDelete: Restrict)
  recordedBy   User?        @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([organizationId, paidAt])
  @@index([organizationId, status])
  @@index([status])
  @@index([paidAt])
  @@map("payment_records")
}

